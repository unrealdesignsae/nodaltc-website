# Set a Web3Forms public form key with a confirmed email recipient; uploads may require Pro.
NEXT_PUBLIC_WEB3FORMS_KEY=
# Verified business WhatsApp number in international digits, no + or spaces.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Verified Sound Level Management URL. Until set, offers a clearly labeled email enquiry.
NEXT_PUBLIC_SOUND_LEVEL_URL=
# Canonical production domain; nodaltc.com launch authorized 6 October 2026.
NEXT_PUBLIC_SITE_URL=
# Keep false on review deployments until all launch checks are complete.
NEXT_PUBLIC_ALLOW_INDEXING=false
